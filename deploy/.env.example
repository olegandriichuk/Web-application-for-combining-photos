# Git build args
REPO=https://github.com/olegandriichuk/Web-application-for-combining-photos.git
BRANCH=docker

# Cloud PostgreSQL (e.g. Neon — neon.tech)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Upstash Redis (rediss:// with TLS)
REDIS_URL=rediss://default:password@host.upstash.io:6379
REDIS_ENABLED=true

# JWT
SECRET_KEY=your-secret-key-here

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=

# Exposea path — /app/exposea inside Docker (set by Dockerfile ENV, no need to override)
# For the host worker, set this to wherever you cloned Exposea on your machine
# EXPOSEA_PATH=/home/you/Exposea
